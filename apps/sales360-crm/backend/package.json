{
  "name": "@apaas/sales360-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && node dist/main.js",
    "build": "prisma generate && tsc -p tsconfig.build.json && mkdir -p dist/generated/client && cp -R src/generated/client/. dist/generated/client/",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "admin:create": "tsx src/bootstrap-admin.ts",
    "admin:reset": "node dist/reset-admin.js",
    "local:seed": "tsx src/local-seed.ts",
    "test:e2e": "node tests/core-flow.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.6",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
