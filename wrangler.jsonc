{
  "name": "apaas-sales360-crm",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./apps/sales360-crm/frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
